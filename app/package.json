{
  "name": "dftlab",
  "version": "1.0.0",
  "private": true,
  "description": "DFT Lab: curso y postproceso de cálculos SIESTA en el navegador",
  "type": "module",
  "scripts": {
    "test": "node ../scripts/verify.mjs --browser",
    "test:node": "node ../scripts/verify.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "browser:install": "playwright install chromium",
    "build": "node scripts/build.mjs",
    "contracts:generate": "node scripts/generate-contract-validators.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "engines": {
    "node": "24.18.0"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.25.10",
    "playwright": "1.56.1"
  }
}
