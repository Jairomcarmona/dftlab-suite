   1 0.000000 0.000000 0.000000  \Gamma
  30 0.500000 0.000000 0.500000  X
  30 0.625000 0.250000 0.625000  U
   1 0.375000 0.375000 0.750000  K
  30 0.000000 0.000000 0.000000  \Gamma
  30 0.500000 0.500000 0.500000  L
  30 0.500000 0.250000 0.750000  W
  30 0.500000 0.000000 0.500000  X
%endblock BandLines
%block ProjectedDensityOfStates
 -15.0 10.0 0.05 1000 eV
%endblock ProjectedDensityOfStates
%block PDOS.kgrid_Monkhorst_Pack
 16 0 0 0.5
 0 16 0 0.5
 0 0 16 0.5
%endblock PDOS.kgrid_Monkhorst_Pack
