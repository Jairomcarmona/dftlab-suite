    {
      "path": "fixtures/operation-resolution-receipt/valid/submit-no-intent.json",
      "schema": "operation-resolution-receipt.schema.json",
      "expect": "valid",
      "rule": "Envío caído antes de confirmar el EffectIntent: no pudo llegar al scheduler."
    },
    {
      "path": "fixtures/operation-resolution-receipt/valid/local-committed.json",
      "schema": "operation-resolution-receipt.schema.json",
      "expect": "valid",
      "rule": "El producto local quedó confirmado: SUCCEEDED con su referencia."
