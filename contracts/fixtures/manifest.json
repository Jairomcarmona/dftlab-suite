    {
      "path": "fixtures/operation-resolution-receipt/invalid/committed-without-products.json",
      "schema": "operation-resolution-receipt.schema.json",
      "expect": "invalid",
      "rule": "LOCAL_EFFECT_COMMITTED nombra el producto confirmado."
    },
    {
      "path": "fixtures/operation-request/valid/create-campaign.json",
      "schema": "operation-request.schema.json",
